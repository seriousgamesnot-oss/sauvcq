#!/usr/bin/env python3
"""Kinematic fake vehicle: follows ControlSetpoint, publishes EKF, IMU and front-camera gate detections."""
import math

import rclpy
from rclpy.node import Node
from nav_msgs.msg import Odometry
from sensor_msgs.msg import Imu
from sauvc_interfaces.msg import ControlSetpoint, GateDetection


def wrap(a):
    return (a + math.pi) % (2.0 * math.pi) - math.pi


class MockVehicleSim(Node):
    def __init__(self):
        super().__init__('mock_vehicle_sim')
        self.declare_parameter('gate_x', 6.0)
        self.declare_parameter('gate_y', 0.4)
        self.declare_parameter('max_speed', 0.4)
        self.declare_parameter('max_yaw_rate_deg', 40.0)
        self.declare_parameter('max_depth_rate', 0.25)
        self.x = self.y = self.yaw = self.depth = 0.0
        self.sp = None
        self.dt = 1.0 / 30.0
        self.odom_pub = self.create_publisher(Odometry, '/odometry/filtered', 10)
        self.imu_pub = self.create_publisher(Imu, '/imu/data', 10)
        self.gate_pub = self.create_publisher(GateDetection, '/varuna/gate_detection', 10)
        self.create_subscription(ControlSetpoint, '/varuna/control_setpoint', self.on_sp, 10)
        self.create_timer(self.dt, self.step)

    def on_sp(self, msg):
        self.sp = msg

    def step(self):
        ms = self.get_parameter('max_speed').value
        yr = math.radians(self.get_parameter('max_yaw_rate_deg').value) * self.dt
        dr = self.get_parameter('max_depth_rate').value * self.dt
        sp = self.sp
        if sp is not None:
            self.depth += max(-dr, min(dr, sp.desired_depth - self.depth))
            if sp.control_mode != ControlSetpoint.MODE_IDLE:
                dx = sp.desired_position.x - self.x
                dy = sp.desired_position.y - self.y
                d = math.hypot(dx, dy)
                if d > 1e-4:
                    v = min(ms, d)
                    self.x += dx / d * v * self.dt
                    self.y += dy / d * v * self.dt
                self.yaw = wrap(self.yaw + max(-yr, min(yr, wrap(sp.desired_yaw - self.yaw))))

        now = self.get_clock().now().to_msg()
        qz, qw = math.sin(self.yaw / 2.0), math.cos(self.yaw / 2.0)

        o = Odometry()
        o.header.stamp = now
        o.header.frame_id = 'odom'
        o.pose.pose.position.x = self.x
        o.pose.pose.position.y = self.y
        o.pose.pose.position.z = -self.depth
        o.pose.pose.orientation.z = qz
        o.pose.pose.orientation.w = qw
        self.odom_pub.publish(o)

        i = Imu()
        i.header.stamp = now
        i.header.frame_id = 'imu'
        i.orientation.z = qz
        i.orientation.w = qw
        self.imu_pub.publish(i)

        gx = self.get_parameter('gate_x').value
        gy = self.get_parameter('gate_y').value
        bx = math.cos(self.yaw) * (gx - self.x) + math.sin(self.yaw) * (gy - self.y)
        by = -math.sin(self.yaw) * (gx - self.x) + math.cos(self.yaw) * (gy - self.y)
        if bx > 0.6 and math.hypot(bx, by) < 8.0 and abs(math.atan2(by, bx)) < math.radians(40.0):
            g = GateDetection()
            g.header.stamp = now
            g.header.frame_id = 'front_camera'
            g.camera_id = 'front'
            g.confidence = 0.9
            g.has_position = True
            g.position.x = bx
            g.position.y = by
            g.orientation.w = 1.0
            self.gate_pub.publish(g)

        self.get_logger().info(
            'x=%.2f y=%.2f yaw=%.0fdeg depth=%.2f' % (self.x, self.y, math.degrees(self.yaw), self.depth),
            throttle_duration_sec=2.0)


def main():
    rclpy.init()
    node = MockVehicleSim()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
