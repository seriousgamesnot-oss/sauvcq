#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from std_msgs.msg import Float64
from sensor_msgs.msg import Imu

class MockControls(Node):
    def __init__(self):
        super().__init__('mock_controls')
        self.declare_parameters(
            namespace='',
            parameters=[
                ('scenario', 'full_run'),
                ('initial_depth_m', 0.0),
                ('initial_yaw_deg', 0.0),
                ('heave_response_tau_s', 1.2),
                ('yaw_response_tau_s', 0.6),
                ('depth_noise_std_m', 0.02),
                ('imu_yaw_noise_std_deg', 0.5),
                ('fault_inject_at_sec', 10.0),
                ('fault_depth_m', 2.8),
                ('fault_duration_sec', 2.0),
                ('heave_cmd_topic', '/varuna/heave_cmd'),
                ('cmd_vel_topic', '/varuna/cmd_vel'),
                ('depth_topic', '/varuna/depth'),
                ('imu_topic', '/varuna/imu'),
                ('depth_rate_hz', 20.0),
                ('imu_rate_hz', 50.0)
            ]
        )
        self.get_logger().info("Mock Controls initialized.")
        # TODO: Implement first-order dynamics and fault injection

def main(args=None):
    rclpy.init(args=args)
    node = MockControls()
    rclpy.spin(node)
    rclpy.shutdown()

if __name__ == '__main__':
    main()
