#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from nav_msgs.msg import Odometry
from geometry_msgs.msg import Twist
from rclpy.action import ActionServer
# from sauvc_interfaces.action import MoveToRelativePose # Uncomment when implementing

class MockNavigation(Node):
    def __init__(self):
        super().__init__('mock_navigation')
        self.declare_parameters(
            namespace='',
            parameters=[
                ('scenario', 'full_run'),
                ('surge_max_m_s', 0.5),
                ('yaw_rate_max_deg_s', 25.0),
                ('odom_rate_hz', 20.0),
                ('cmd_vel_topic', '/varuna/cmd_vel'),
                ('odom_topic', '/varuna/odom'),
                ('move_to_pose_action', '/sauvc/move_to_pose'),
                ('vehicle_length_m', 0.65)
            ]
        )
        self.get_logger().info("Mock Navigation initialized.")
        # TODO: Setup odom publisher, cmd_vel subscriber, and fake action server

def main(args=None):
    rclpy.init(args=args)
    node = MockNavigation()
    rclpy.spin(node)
    rclpy.shutdown()

if __name__ == '__main__':
    main()
