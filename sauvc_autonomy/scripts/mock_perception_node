#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import CompressedImage
from geometry_msgs.msg import PoseStamped

class MockPerception(Node):
    def __init__(self):
        super().__init__('mock_perception')
        # Declare parameters expected by launch file
        self.declare_parameters(
            namespace='',
            parameters=[
                ('scenario', 'full_run'),
                ('gate_visible_after_sec', 3.0),
                ('gate_hidden_from_sec', 10.0),
                ('gate_hidden_until_sec', 12.0),
                ('gate_initial_distance_m', 4.0),
                ('gate_lateral_offset_m', 0.15),
                ('gate_yaw_offset_deg', 5.0),
                ('detection_confidence_mean', 0.82),
                ('detection_confidence_std', 0.08),
                ('output_camera_topic', '/varuna/camera/front/compressed'),
                ('output_gate_pose_topic', '/varuna/gate_pose')
            ]
        )
        self.get_logger().info("Mock Perception initialized.")
        # TODO: Setup publishers and timers based on parameters

def main(args=None):
    rclpy.init(args=args)
    node = MockPerception()
    rclpy.spin(node)
    rclpy.shutdown()

if __name__ == '__main__':
    main()
